-- Dummy/Mock Object to represent an Attribute as a Value Object
local AttributeMock = {}
AttributeMock.__index = AttributeMock
function AttributeMock.new(instance, attribName)
    return setmetatable({Instance = instance, Name = attribName, ClassName = "AttributeValue", IsMock = true}, AttributeMock)
end
function AttributeMock:IsA(className) return className == "ValueBase" end
-- Custom setter/getter proxy to let the loop treat it like a normal ValueObject
local currentMeta = {
    __index = function(t, k) if k == "Value" then return t.Instance:GetAttribute(t.Name) end return rawget(t, k) end,
    __newindex = function(t, k, v) if k == "Value" then t.Instance:SetAttribute(t.Name, v) else rawset(t, k, v) end end
}

