end)

function Teleport()
    local timeLeft = 40
    while timeLeft > 0 do
        CountdownLabel.Text = "Server Hop In: " .. math.ceil(timeLeft) .. "s"
        task.wait(1)
        timeLeft = timeLeft - 1
    end
    
    local attempts = 0
    local targetServer = nil
    
    while not targetServer and attempts < 10 do
        CountdownLabel.Text = "Searching Server (Attempt " .. (attempts + 1) .. ")..."
        targetServer = GetNextServerID()
        if not targetServer then
            attempts = attempts + 1
            task.wait(1)
        end
    end
    
    if targetServer then
        table.insert(AllIDs, targetServer)
        pcall(writefile, "NotSameServers.json", HttpService:JSONEncode(AllIDs))
        
        CountdownLabel.Text = "Server Hopping..."
        
        local teleportOptions = Instance.new("TeleportOptions")
        
        TeleportService.TeleportInitFailed:Connect(function(player, result, message)
            CountdownLabel.Text = "Retrying Hop..."
            task.wait(2)
            Teleport()
        end)

        pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceID, targetServer, player)
        end)
    else
        CountdownLabel.Text = "No Servers Found. Resetting History..."
        AllIDs = {actualHour}
        pcall(writefile, "NotSameServers.json", HttpService:JSONEncode(AllIDs))
        task.wait(2)
        Teleport()
    end
end

task.spawn(function()
    Teleport()
end)
