-- Number Abbreviation Engine (1000 -> 1K)
local suffixes = {"K", "M", "B", "T", "QA", "QI"}
local function formatNumber(value)
    if not value or typeof(value) ~= "number" then return "0" end
    if value < 1000 then return tostring(value) end
    
    local index = math.floor(math.log10(value) / 3)
    local suffix = suffixes[index] or ""
    local abbreviated = value / (10 ^ (index * 3))
    
    return string.format("%.1f", abbreviated):gsub("%.0$", "") .. suffix
end

-- Nuclear Search Engine: Intercepts Folders, Character Model, Attributes, and Fuzzy Plurals
local function locatePlayerStatObject(targetPlayer, statName)
    if not targetPlayer then return nil end
    local cleanTarget = string.lower(string.gsub(statName, "%s+", ""))
    
    -- --- METHOD 1: ATTRIBUTE SCAN (Most Modern Games) ---
    -- Check attributes on Player instance
    for attribName, _ in pairs(targetPlayer:GetAttributes()) do
        local cleanAttrib = string.lower(string.gsub(attribName, "%s+", ""))
        if cleanAttrib:find(cleanTarget) or cleanTarget:find(cleanAttrib) then
            local mock = AttributeMock.new(targetPlayer, attribName)
            return setmetatable(mock, currentMeta)
        end
    end
    -- Check attributes on Character Model
    if targetPlayer.Character then
        for attribName, _ in pairs(targetPlayer.Character:GetAttributes()) do
            local cleanAttrib = string.lower(string.gsub(attribName, "%s+", ""))
            if cleanAttrib:find(cleanTarget) or cleanTarget:find(cleanAttrib) then
                local mock = AttributeMock.new(targetPlayer.Character, attribName)
                return setmetatable(mock, currentMeta)
            end
        end
    end
    
    -- --- METHOD 2: DEEP FOLDER SCAN & FUZZY MATCH ---
    local possibleFolders = {
        "leaderstats", "Leaderboard", "Stats", "localstats", "Data", "leaderstats2", 
        "Karma", "PlayerData", "Save", "Currency", "PointData", "Statistics", 
        "PlayerStats", "Values", "LevelData", "Inventory", "HiddenStats", "CashData",
        "Attributes", "Status", "RankData", "UserStats", "GameData"
    }
    
    -- Check predefined folders with fuzzy text boundaries
    for _, folderName in ipairs(possibleFolders) do
        local folder = targetPlayer:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                local cleanChildName = string.lower(string.gsub(child.Name, "%s+", ""))
                if cleanChildName:find(cleanTarget) or cleanTarget:find(cleanChildName) then 
                    return child 
                end
            end
        end
    end
    
    -- Scan custom folders inside player root
    for _, child in ipairs(targetPlayer:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Configuration") then
            for _, subChild in ipairs(child:GetChildren()) do
                local cleanSubChildName = string.lower(string.gsub(subChild.Name, "%s+", ""))
                if cleanSubChildName:find(cleanTarget) or cleanTarget:find(cleanSubChildName) then 
                    return subChild 
                end
            end
        end
    end
    
    -- Scan character model folders
    if targetPlayer.Character then
        for _, child in ipairs(targetPlayer.Character:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Configuration") or child.ClassName:find("Value") then
                local cleanChildName = string.lower(string.gsub(child.Name, "%s+", ""))
                if cleanChildName:find(cleanTarget) or cleanTarget:find(cleanChildName) then 
                    return child 
                end
            end
        end
    end
    
    return nil
end

