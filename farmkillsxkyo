-- Working Proxy Server Hopper
local function serverHopToCrowdedServer()
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    
    -- Using RoProxy to bypass Roblox's inner HttpGet API block
    local baseURL = "https://roproxy.com" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100"
    local cursor = ""
    
    for i = 1, 3 do -- Scan up to 3 pages deep to find the absolute full/best servers
        local apiURL = baseURL .. (cursor ~= "" and "&cursor=" .. cursor or "")
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(apiURL))
        end)
        
        if success and result and result.data then
            local bestServers = {}
            for _, server in ipairs(result.data) do
                -- Filter out your current server, empty servers, or broken servers
                if server.id ~= currentJobId and server.playing < server.maxPlayers and server.playing > 1 then
                    table.insert(bestServers, server)
                end
            end
            
            -- Sort by highest player count descending
            table.sort(bestServers, function(a, b)
                return a.playing > b.playing
            end)
            
            -- Teleport to a top crowded server
            if #bestServers > 0 then
                -- Target the highest populated server that has slots open
                local targetServer = bestServers[1]
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, player)
                end)
                return
            end
            
            -- Advance to the next page if no active open servers are on this block
            if result.nextPageCursor and result.nextPageCursor ~= "" then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
    end
    
    -- Ultimate fallback if API errors or RoProxy fails
    pcall(function()
        TeleportService:Teleport(placeId, player)
    end)
end

