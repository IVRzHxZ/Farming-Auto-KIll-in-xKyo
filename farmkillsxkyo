-- Server hop timing loop
function Teleport()
    -- Segmented 10-second wait to dynamically visual-update the screen label text
    local timeLeft = 40
    while timeLeft > 0 do
        CountdownLabel.Text = "Server Hop In: " .. math.ceil(timeLeft) .. "s"
        task.wait(1)
        timeLeft = timeLeft - 1
    end
    CountdownLabel.Text = "Searching Server..."
    
    -- Fetch a new server tracking ID destination
    local targetServer = GetNextServerID()
    if targetServer then
        table.insert(AllIDs, targetServer)
        pcall(writefile, "NotSameServers.json", HttpService:JSONEncode(AllIDs))
        
        CountdownLabel.Text = "Server Hopping..."
        -- Execute cross server migration safely
        TeleportService:TeleportToPlaceInstance(PlaceID, targetServer, player)
    else
        -- If no server was found, clear cache and look again to prevent loop breakages
        AllIDs = {actualHour}
        pcall(writefile, "NotSameServers.json", HttpService:JSONEncode(AllIDs))
        task.wait(1)
    end
end

-- Initial execution call point for hopping
task.spawn(function()
    while true do
        Teleport()
        task.wait(1) -- Safeguard fallback timing limit
    end
end)
