-- Completely standalone automated TP kill script running infinitely
local function AutoKillLobby()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local targetList = Players:GetPlayers()
    
    for _, targetPlayer in ipairs(targetList) do
        if targetPlayer ~= player and targetPlayer.Character and not isWhitelisted(targetPlayer) then
            local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            local timeSpent = 0
            
            -- Keep targeting the designated individual for up to 0.5s max
            while tRoot and tHumanoid and tHumanoid.Health > 0 and targetPlayer.Parent == Players and timeSpent < 0.5 do
                local myChar = player.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
                
                if not (myChar and myRoot and myHumanoid) then 
                    task.wait(0.1)
                    break 
                end
                
                -- Teleports your character directly behind the enemy player
                myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                
                -- Tool verification and automatic equipping
                local tool = myChar:FindFirstChild("Punch")
                if not tool then
                    local backpack = player:FindFirstChild("Backpack")
                    local bpTool = backpack and backpack:FindFirstChild("Punch")
                    if bpTool then
                        myHumanoid:EquipTool(bpTool)
                        tool = bpTool
                    end
                end
                
                if tool then tool:Activate() end
                
                -- Fires game specific resize remotes automatically
                local remotes = ReplicatedStorage:FindFirstChild("RemotesEvent")
                if remotes and remotes:FindFirstChild("SizeChanged") then
                    remotes.SizeChanged:FireServer(1)
                end
                
                -- Verify if blow landed a killing strike
                if tHumanoid.Health <= 0 then
                    TotalKills = TotalKills + 1
                    UpdateKillsDisplay()
                    break
                end
                
                task.wait(0.05)
                timeSpent = timeSpent + 0.05 
            end
        end
    end
end

-- Finds a valid target destination server 
function GetNextServerID()
    local Site;
    local url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100'
    if foundAnything ~= "" then
        url = url .. '&cursor=' .. foundAnything
    end
    
    local success, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if not success or not res or not res.data then return nil end
    if res.nextPageCursor and res.nextPageCursor ~= "null" then
        foundAnything = res.nextPageCursor
    end

    for _, v in pairs(res.data) do
        local ID = tostring(v.id)
        if tonumber(v.maxPlayers) > tonumber(v.playing) and ID ~= game.JobId then
            local alreadyVisited = false
            for _, Existing in pairs(AllIDs) do
                if ID == tostring(Existing) then
                    alreadyVisited = true
                    break
                end
            end
            
            if not alreadyVisited then
                return ID
            end
        end
    end
    return nil
end

