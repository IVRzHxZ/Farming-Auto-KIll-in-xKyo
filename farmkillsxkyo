local function UpdateDisplay()
    KillsLabel.Text = "Total Kills: " .. totalKills
    GainedLabel.Text = "Gained Kills: " .. sessionKills
    StreakLabel.Text = "Kill Streak: " .. currentStreak
end

local function setupLeaderboardTracking()
    local leaderstats = player:WaitForChild("leaderstats", 15)
    if not leaderstats then return end

    local killsValue = leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("Kills ")
    local streakValue = leaderstats:FindFirstChild("Streak") or leaderstats:FindFirstChild("KillStreak") or leaderstats:FindFirstChild("Kill Streak")

    if killsValue and (killsValue:IsA("IntValue") or killsValue:IsA("NumberValue")) then
        local lastKills = killsValue.Value
        totalKills = lastKills
        
        killsValue.Changed:Connect(function(newVal)
            local diff = newVal - lastKills
            if diff > 0 then
                sessionKills = sessionKills + diff
            end
            lastKills = newVal
            totalKills = newVal
            UpdateDisplay()
        end)
    end

    if streakValue and (streakValue:IsA("IntValue") or streakValue:IsA("NumberValue")) then
        currentStreak = streakValue.Value
        streakValue.Changed:Connect(function(newVal)
            currentStreak = newVal
            UpdateDisplay()
        end)
    end
    
    UpdateDisplay()
end
task.spawn(setupLeaderboardTracking)

local function isWhitelisted(targetPlayer)
    if not targetPlayer or not targetPlayer:IsA("Player") then return false end
    if friendCache[targetPlayer.UserId] ~= nil then
        return friendCache[targetPlayer.UserId]
    end
    local success, isFriend = pcall(function()
        return player:IsFriendsWith(targetPlayer.UserId)
    end)
    if success then
        friendCache[targetPlayer.UserId] = isFriend
        return isFriend
    end
    return false
end

local function loadHistory()
    if isfile("NotSameServers.json") then
        local content = readfile("NotSameServers.json")
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, content)
        if success and type(decoded) == "table" then
            AllIDs = decoded
        end
    end
    
    if #AllIDs == 0 or AllIDs[1] ~= actualHour then
        AllIDs = {actualHour}
        pcall(writefile, "NotSameServers.json", HttpService:JSONEncode(AllIDs))
    end
end
loadHistory()

local function AutoKillLobby()
    local targetList = Players:GetPlayers()
    
    for _, targetPlayer in ipairs(targetList) do
        if targetPlayer ~= player and targetPlayer.Character and not isWhitelisted(targetPlayer) then
            local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if tRoot and tHumanoid and tHumanoid.Health > 0 then
                local startTime = tick()
                -- Kill loop for 1 second per player
                while tick() - startTime < 1 and tHumanoid.Health > 0 do
                    local myChar = player.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
                    
                    if myChar and myRoot and myHumanoid then
                        -- Lock to player position (directly behind)
                        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        
                        -- Auto Punch Logic
                        local tool = myChar:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
                        if tool then
                            if tool.Parent ~= myChar then
                                myHumanoid:EquipTool(tool)
                            end
                            tool:Activate()
                        end
                        
                        -- Remote trigger if exists
                        local remotes = ReplicatedStorage:FindFirstChild("RemotesEvent")
                        if remotes and remotes:FindFirstChild("SizeChanged") then
                            remotes.SizeChanged:FireServer(1)
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
            end
        end
    end
end

function GetNextServerID()
    local url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Desc&limit=100'
    if foundAnything ~= "" then
        url = url .. '&cursor=' .. foundAnything
    end
    
    local success, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if not success or not res or not res.data then return nil end
    
    if res.nextPageCursor and res.nextPageCursor ~= "" and res.nextPageCursor ~= "null" then
        foundAnything = res.nextPageCursor
    end

    local validServers = {}
    for _, v in pairs(res.data) do
        local ID = tostring(v.id)
        if tonumber(v.maxPlayers) > tonumber(v.playing) and ID ~= game.JobId then
            local alreadyVisited = false
            for _, Existing in pairs(AllIDs) do
                if ID == tostring(Existing) then
                    alreadyVisited = true
                    break
                end
            end
            
            if not alreadyVisited then
                table.insert(validServers, ID)
            end
        end
    end
    
    if #validServers > 0 then
        return validServers[math.random(1, #validServers)]
    end
    
    return nil
end

task.spawn(function()
    while true do
